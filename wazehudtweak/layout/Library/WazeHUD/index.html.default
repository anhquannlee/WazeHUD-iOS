<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#000000">
    <title>Waze HUD</title>
    
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            background-color: #000000;
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            margin: 0;
            padding: 0;
            position: relative;
            transition: background 0.3s, color 0.3s;
        }

        /* --- ÉP NGANG & TRÀN VIỀN 100% --- */
        @media screen and (orientation: portrait) {
            #hud-container {
                position: absolute;
                top: 0;
                left: 100vw;
                width: 100vh;
                height: 100vw;
                transform: rotate(90deg);
                transform-origin: top left;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 4px 6px;
            }
        }

        @media screen and (orientation: landscape) {
            #hud-container {
                position: absolute;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                transform: none;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 4px 6px;
            }
        }

        /* --- XỬ LÝ LIGHT MODE KHÔNG MÙ CHỮ --- */
        body.day-mode { background-color: #f0f2f5; color: #000000; }
        body.day-mode .top-bar { background: rgba(0, 0, 0, 0.08); border-color: rgba(0,0,0,0.15); color: #222; }
        body.day-mode .time { color: #0d47a1; }
        body.day-mode .eta-info { color: #333333; font-weight: 800; }
        body.day-mode .ping-box { color: #0277bd; }

        body.day-mode .turn-distance { color: #000000; }
        body.day-mode .turn-street { color: #01579b; font-weight: 900; }
        
        body.day-mode .current-street { color: #333333 !important; font-weight: 800; }
        body.day-mode .label-text { color: #757575 !important; font-weight: 600; }
        
        /* CHỈNH LẠI NÚT ĐỒNG NHẤT Ở LIGHT MODE */
        body.day-mode .q-btn { 
            background: rgba(0,0,0,0.06); 
            color: #000000; 
            border-color: rgba(0,0,0,0.2); 
            box-shadow: 0 2px 5px rgba(0,0,0,0.1); 
        }
        body.day-mode .q-label { color: #333333; font-weight: 800; }
        body.day-mode .quick-actions { opacity: 0.3; } 
        body.day-mode .quick-actions.active { opacity: 1; }

        body.day-mode .speed-val { color: #000000; }
        body.day-mode .speed-circle { background: radial-gradient(circle, #e3f2fd 0%, #bbdefb 100%); border-color: #1976d2; }
        body.day-mode .speed-unit { color: #0d47a1; }
        body.day-mode .turn-panel { background: rgba(0, 0, 0, 0.05); border-color: rgba(0,0,0,0.12); }
        body.day-mode .turn-icon { color: #0288d1; }
        body.day-mode .turn-instruction { color: #d32f2f !important; }

        .mirror-x #hud-inner { transform: scaleX(-1); }
        .mirror-y #hud-inner { transform: rotate(180deg); }
        .mirror-xy #hud-inner { transform: scaleX(-1) rotate(180deg); }

        #hud-inner {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
            width: 100%;
            transition: transform 0.3s ease;
        }

        /* --- SIZE TO (MẶC ĐỊNH) --- */
        .turn-icon { font-size: 3.5rem; line-height: 1; color: #00e5ff; }
        .turn-distance { font-size: 3.4rem; font-weight: 900; color: #ffffff; letter-spacing: -1.5px; }
        
        .turn-street { font-size: 1.3rem; font-weight: 800; color: #00e5ff; margin-top: 2px; }
        .current-street { font-size: 0.95rem; font-weight: 700; color: #cfd8dc; margin-top: 2px; }
        .label-text { font-size: 0.75em; font-weight: 600; color: #b0bec5; margin-right: 4px; text-transform: uppercase; letter-spacing: 0.5px;}

        .limit-circle { width: 140px; height: 140px; background-color: #ffffff; border: 12px solid #ff1744; border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 0 15px rgba(255, 23, 68, 0.3); }
        .limit-val { font-size: 3.8rem; font-weight: 900; color: #000000; line-height: 1; }
        
        .speed-circle { width: 155px; height: 155px; background: radial-gradient(circle, #1a237e 0%, #0d1117 100%); border: 6px solid #651fff; border-radius: 50%; display: flex; flex-direction: column; justify-content: center; align-items: center; box-shadow: 0 0 15px rgba(101, 31, 255, 0.3); }
        .speed-val { font-size: 4.6rem; font-weight: 900; line-height: 1; color: #ffffff; }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.05);
            padding: 4px 8px;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 4px;
        }
        
        .status-container { display: flex; align-items: center; gap: 12px; }
        .ping-box { display: flex; align-items: center; gap: 4px; font-size: 0.8rem; color: #90caf9; font-weight: 700; }
        .center-info { display: flex; align-items: center; gap: 10px; font-size: 0.95rem; font-weight: 700; }
        .time { color: #90caf9; }
        .eta-info { color: #e0e0e0; }

        /* --- SIZE CỰC ĐẠI --- */
        .size-xl .top-bar { padding: 6px 12px; }
        .size-xl .ping-box { font-size: 0.95rem; }
        
        .size-xl .turn-icon { font-size: 4rem; }
        .size-xl .turn-distance { font-size: 4.2rem; }
        .size-xl .turn-street { font-size: 1.5rem; }
        .size-xl .current-street { font-size: 1.15rem; }

        .size-xl .limit-circle { width: 165px; height: 165px; border-width: 14px; }
        .size-xl .limit-val { font-size: 4.6rem; }
        
        .size-xl .speed-circle { width: 185px; height: 185px; border-width: 8px; }
        .size-xl .speed-val { font-size: 5.6rem; }

        .main-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex: 1;
            padding: 0;
            gap: 5px;
        }

        .turn-panel {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            flex: 1.3;
            background: rgba(255, 255, 255, 0.03);
            padding: 8px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            position: relative;
        }

        .roundabout-exit { position: absolute; top: 4px; right: 6px; background: #ff9800; color: #000; font-weight: 900; font-size: 0.8rem; padding: 2px 6px; border-radius: 4px; }
        .turn-header { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 2px; width: 100%; }
        .turn-instruction { font-size: 1.2rem; font-weight: 900; color: #ffeb3b; }
        .turn-info-box { display: flex; flex-direction: column; align-items: center; width: 100%; margin-bottom: 2px; }
        .turn-street, .current-street { width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .limit-panel { display: flex; flex-direction: column; justify-content: center; align-items: center; flex: 0.8; gap: 8px; }

        #alert-banner {
            background: linear-gradient(135deg, #e53935 0%, #c62828 100%); color: #ffffff; padding: 5px 12px; border-radius: 6px; font-size: 0.9rem; font-weight: 800; display: flex; align-items: center; gap: 6px; width: max-content; max-width: 100%; justify-content: center; border: 1px solid rgba(255,255,255,0.4); animation: pulse-alert 1s infinite alternate;
        }
        @keyframes pulse-alert { 0% { transform: scale(1); } 100% { transform: scale(1.02); } }
        .hidden { display: none !important; }

        .speed-panel { display: flex; flex-direction: column; align-items: center; flex: 1; }
        .speed-unit { font-size: 0.85rem; color: #b388ff; margin-top: 2px; font-weight: 800; letter-spacing: 1px; }

        body.free-drive-mode .turn-panel { display: none !important; }
        body.free-drive-mode .limit-panel, body.free-drive-mode .speed-panel { flex: 1; }
        
        .free-bottom-bar { display: none; width: 100%; text-align: center; padding: 6px 0; background: rgba(255, 255, 255, 0.03); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.08); margin-top: 4px; }
        body.free-drive-mode .free-bottom-bar { display: block; }
        body.day-mode .free-bottom-bar { background: rgba(0, 0, 0, 0.05); border-color: rgba(0,0,0,0.12); }
        .free-bottom-bar .turn-street { font-size: 1.4rem; color: #00e5ff; }
        .size-xl .free-bottom-bar .turn-street { font-size: 1.8rem; }

        .ip-highlight { color: #00e676 !important; font-family: monospace; font-size: 1.5rem !important; font-weight: 900 !important; letter-spacing: 0.5px; user-select: all; }

        /* --- 6 NÚT CỐ ĐỊNH (MÀU ĐỒNG NHẤT, SANG TRỌNG) --- */
        .quick-actions-wrapper {
            position: absolute;
            bottom: 4px;
            right: 8px;
            z-index: 1000;
        }
        
        .quick-actions {
            display: flex;
            gap: 12px;
            opacity: 0.5;
            transition: opacity 0.3s ease;
            touch-action: manipulation;
            user-select: none;
            -webkit-user-select: none;
        }
        .quick-actions:hover, .quick-actions.active { opacity: 1; }
        .quick-btn-item { display: flex; flex-direction: column; align-items: center; cursor: pointer; background: none; border: none; touch-action: manipulation; }
        
        /* CHỈNH LẠI NÚT ĐỒNG NHẤT Ở DARK MODE */
        .q-btn { 
            width: 34px; 
            height: 34px; 
            border-radius: 50%; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            color: #ffffff; 
            background: rgba(255, 255, 255, 0.12); /* Trắng mờ sang trọng */
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(4px);
        }

        .q-label { font-size: 0.6rem; color: #b0bec5; margin-top: 4px; font-weight: 700; white-space: nowrap; }

        svg.lucide { width: 20px; height: 20px; stroke-width: 2.5; stroke: currentColor; fill: none; stroke-linecap: round; stroke-linejoin: round; }
        .alert-icon svg.lucide { width: 22px; height: 22px; stroke-width: 2; margin-right: 4px;}
        .ping-icon svg.lucide { width: 16px; height: 16px; stroke-width: 2.5; }
        .batt-icon svg.lucide { width: 18px; height: 18px; stroke-width: 2; fill: currentColor;}
        .nav-icon svg.lucide { width: 46px; height: 46px; stroke-width: 2.5; }

        .icon-sun { display: block; }
        .icon-moon { display: none; }
        body.day-mode .icon-sun { display: none; }
        body.day-mode .icon-moon { display: block; }
    </style>
</head>
<body onclick="wakeUpControls()" ontouchstart="wakeUpControls()">

    <div id="hud-container">
        <div id="hud-inner">
            <div class="top-bar">
                <div class="status-container">
                    <div class="ping-box" id="ping-info">
                        <span class="ping-icon"><svg class="lucide" viewBox="0 0 24 24"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" x2="12.01" y1="20" y2="20"/></svg></span>
                        <span id="ping-val">-- ms</span>
                    </div>
                </div>
                
                <div class="center-info">
                    <span class="time" id="clock">00:00:00</span>
                    <span>•</span>
                    <span class="eta-info" id="eta-text">Đang di chuyển tự do</span>
                </div>
                <div style="width: 50px;"></div>
            </div>

            <div class="main-content">
                <div class="turn-panel" id="turn-panel">
                    <div class="roundabout-exit hidden" id="exit-badge">Lối ra số 1</div>
                    
                    <div class="turn-header" id="nav-header">
                        <div class="turn-icon nav-icon" id="turn-icon">
                            <svg class="lucide" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div class="turn-instruction" id="turn-instruction">Chờ kết nối...</div>
                    </div>

                    <div class="turn-info-box">
                        <div class="turn-distance hidden" id="distance">--- m</div>
                        <div class="turn-street ip-highlight" id="street">Đang tải...</div>
                        <div class="current-street" id="current-street" style="display:block;">Nhập IP &amp; Port vào App Waze Mod</div>
                    </div>
                </div>

                <div class="limit-panel">
                    <div class="limit-circle hidden" id="limit-box">
                        <div class="limit-val" id="limit">0</div>
                    </div>
                    <div id="alert-banner" class="hidden">
                        <span class="alert-icon" id="alert-icon"><svg class="lucide" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg></span>
                        <span id="alert-text">Cảnh báo giao thông</span>
                    </div>
                </div>

                <div class="speed-panel">
                    <div class="speed-circle">
                        <div class="speed-val" id="speed">0</div>
                        <div class="speed-unit">KM/H</div>
                    </div>
                </div>
            </div>

            <div class="free-bottom-bar" id="free-bottom-bar">
                <div class="turn-street ip-highlight" id="street-free">Đang tải...</div>
            </div>
        </div>
        
        <div class="quick-actions-wrapper">
            <div class="quick-actions" id="quick-menu" onclick="event.stopPropagation()">
                <button class="quick-btn-item" onclick="toggleFullScreen()">
                    <div class="q-btn"><svg class="lucide" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg></div>
                    <span class="q-label">Toàn màn</span>
                </button>
                <button class="quick-btn-item" onclick="toggleMirror('mirror-x')">
                    <div class="q-btn"><svg class="lucide" viewBox="0 0 24 24"><polyline points="15 3 21 9 15 15"/><polyline points="9 21 3 15 9 9"/><line x1="21" x2="11" y1="9" y2="9"/><line x1="3" x2="13" y1="15" y2="15"/></svg></div>
                    <span class="q-label">Lật Gương</span>
                </button>
                <button class="quick-btn-item" onclick="toggleMirror('mirror-y')">
                    <div class="q-btn"><svg class="lucide" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg></div>
                    <span class="q-label">Lật 180°</span>
                </button>
                <button class="quick-btn-item" onclick="toggleTheme()">
                    <div class="q-btn">
                        <svg class="lucide icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                        <svg class="lucide icon-moon" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                    </div>
                    <span class="q-label">Giao Diện</span>
                </button>
                <button class="quick-btn-item" onclick="cycleLayoutSize()">
                    <div class="q-btn"><svg class="lucide" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/></svg></div>
                    <span class="q-label" id="size-label">Cỡ Thường</span>
                </button>
                <button class="quick-btn-item" onclick="window.location.reload()">
                    <div class="q-btn"><svg class="lucide" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg></div>
                    <span class="q-label">Làm mới</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        let activeWsPort = 8765;
        let ws = null;

        function updateConnectionDisplay(ip, port) {
            const displayText = `IP:${ip} Port:${port}`;
            const streetEl = document.getElementById('street');
            const streetFreeEl = document.getElementById('street-free');
            const curStreetEl = document.getElementById('current-street');

            if (streetEl && streetEl.classList.contains('ip-highlight')) {
                streetEl.innerText = displayText;
            }
            if (streetFreeEl && streetFreeEl.classList.contains('ip-highlight')) {
                streetFreeEl.innerText = displayText;
            }
            if (curStreetEl && curStreetEl.style.display !== 'none' && !curStreetEl.innerText.includes('Hiện tại:')) {
                curStreetEl.innerText = 'Nhập IP & Port vào App Waze Mod';
            }
        }

        const initialHost = (window.location.hostname && window.location.hostname !== 'localhost') ? window.location.hostname : '127.0.0.1';
        updateConnectionDisplay(initialHost, activeWsPort);

        const sizes = ['', 'size-xl'];
        const sizeNames = ['To', 'Cực Đại'];
        let currentSizeIdx = 0;
        let hideTimer = null;
        let wakeLock = null;
        let lastPingTime = 0;

        let isMirrorX = false;
        let isMirrorY = false;

        async function keepScreenOn() {
            if ('wakeLock' in navigator && wakeLock === null) {
                try {
                    wakeLock = await navigator.wakeLock.request('screen');
                    wakeLock.addEventListener('release', () => { wakeLock = null; });
                } catch (err) {}
            }
        }

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                if (document.documentElement.requestFullscreen) {
                    document.documentElement.requestFullscreen();
                } else if (document.documentElement.webkitRequestFullscreen) {
                    document.documentElement.webkitRequestFullscreen();
                }
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                }
            }
            wakeUpControls();
        }

        function wakeUpControls() {
            const menu = document.getElementById('quick-menu');
            menu.classList.add('active');
            keepScreenOn();
            clearTimeout(hideTimer);
            hideTimer = setTimeout(() => {
                menu.classList.remove('active');
            }, 3000);
        }

        wakeUpControls();

        function updateClock() {
            const now = new Date();
            document.getElementById('clock').innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
        setInterval(updateClock, 1000);
        updateClock();

        function updateMirrorClass() {
            const container = document.getElementById('hud-container');
            container.classList.remove('mirror-x', 'mirror-y', 'mirror-xy');
            
            if (isMirrorX && isMirrorY) {
                container.classList.add('mirror-xy');
            } else if (isMirrorX) {
                container.classList.add('mirror-x');
            } else if (isMirrorY) {
                container.classList.add('mirror-y');
            }
        }

        function toggleMirror(type) {
            if (type === 'mirror-x') isMirrorX = !isMirrorX;
            if (type === 'mirror-y') isMirrorY = !isMirrorY;
            updateMirrorClass();
            wakeUpControls();
        }

        function toggleTheme() {
            document.body.classList.toggle('day-mode');
            wakeUpControls();
        }

        function cycleLayoutSize() {
            const container = document.getElementById('hud-inner');
            sizes.forEach(s => { if(s) container.classList.remove(s); });
            
            currentSizeIdx = (currentSizeIdx + 1) % sizes.length;
            if (sizes[currentSizeIdx]) {
                container.classList.add(sizes[currentSizeIdx]);
            }
            document.getElementById('size-label').innerText = sizeNames[currentSizeIdx];
            wakeUpControls();
        }

        const IconStraight = `<svg class="lucide" viewBox="0 0 24 24"><line x1="12" x2="12" y1="20" y2="4"/><polyline points="5 11 12 4 19 11"/></svg>`;
        const IconLeft = `<svg class="lucide" viewBox="0 0 24 24"><polyline points="9 6 4 11 9 16"/><path d="M20 21v-6a4 4 0 0 0-4-4H4"/></svg>`;
        const IconRight = `<svg class="lucide" viewBox="0 0 24 24"><polyline points="15 6 20 11 15 16"/><path d="M4 21v-6a4 4 0 0 1 4-4h12"/></svg>`;
        const IconSlightLeft = `<svg class="lucide" viewBox="0 0 24 24"><polyline points="8 5 3 10 8 15"/><path d="M3 10h8c3.3 0 6 2.7 6 6v4"/></svg>`;
        const IconSlightRight = `<svg class="lucide" viewBox="0 0 24 24"><polyline points="16 5 21 10 16 15"/><path d="M21 10h-8c-3.3 0-6 2.7-6 6v4"/></svg>`;
        const IconUTurn = `<svg class="lucide" viewBox="0 0 24 24"><path d="M9 10V5a2 2 0 0 1 4 0v14"/><polyline points="5 14 9 18 13 14"/></svg>`;
        const IconRoundabout = `<svg class="lucide" viewBox="0 0 24 24"><path d="M12 21a9 9 0 1 0-9-9"/><path d="M12 12h.01"/><polyline points="12 17 12 21 16 21"/></svg>`;
        const IconArrive = `<svg class="lucide" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`;

        const IconPolice = `<svg class="lucide" viewBox="0 0 24 24"><path d="m12 3-8 3v5c0 4.2 3.1 8 8 10 4.9-2 8-5.8 8-10V6Z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>`;
        const IconCamera = `<svg class="lucide" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><circle cx="12" cy="12" r="4"/><path d="M12 8v.01"/></svg>`;
        const IconTrafficLight = `<svg class="lucide" viewBox="0 0 24 24"><rect width="8" height="18" x="8" y="3" rx="4"/><circle cx="12" cy="8" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="16" r="1"/></svg>`;
        const IconHazard = `<svg class="lucide" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>`;

        function connectWebSocket(port) {
            if (ws) {
                try { ws.close(); } catch(e) {}
            }
            const host = window.location.hostname || '127.0.0.1';
            try {
                ws = new WebSocket(`ws://${host}:${port}/web`);
            } catch(e) {
                return;
            }

            ws.onopen = () => {
                const pingEl = document.getElementById('ping-val');
                if (pingEl) pingEl.innerText = 'Online';
            };

            ws.onclose = () => {
                const pingEl = document.getElementById('ping-val');
                if (pingEl) pingEl.innerText = 'Mất kết nối';
                setTimeout(() => connectWebSocket(port), 3000);
            };

            ws.onerror = () => {
                const pingEl = document.getElementById('ping-val');
                if (pingEl) pingEl.innerText = 'Lỗi kết nối';
            };

            ws.onmessage = (event) => {
                try {
                    let now = Date.now();
                    if (lastPingTime > 0) {
                        let pingValue = now - lastPingTime;
                        const pingEl = document.getElementById('ping-val');
                        if (pingEl) pingEl.innerText = `${pingValue} ms`;
                    }
                    lastPingTime = now;

                    const rawLines = event.data.split('\n');
                    for (const rawLine of rawLines) {
                        const line = rawLine.trim();
                        if (!line) continue;
                        let data;
                        try {
                            data = JSON.parse(line);
                        } catch(err) {
                            continue;
                        }

                        if (data.type === "sys_info") {
                            const devIp = data.ip || '127.0.0.1';
                            const devPort = data.port || port;
                            updateConnectionDisplay(devIp, devPort);
                            continue; 
                        }
                    
                        if (data.host_batt !== undefined) {
                            document.getElementById('batt-val').innerText = `${data.host_batt}%`;
                        }

                        if (data.t === 's' || data.spd !== undefined || data.st !== undefined || data.trn !== undefined) {
                            document.getElementById('street').classList.remove('ip-highlight');
                            document.getElementById('street-free').classList.remove('ip-highlight');

                            let isNavigating = (data.nav === 1);
                            if (isNavigating) {
                                document.body.classList.remove('free-drive-mode');
                            } else {
                                document.body.classList.add('free-drive-mode');
                            }

                            if (data.spd !== undefined) {
                                document.getElementById('speed').innerText = data.spd;
                            }
                            
                            const limitBox = document.getElementById('limit-box');
                            if (data.lim !== undefined && data.lim > 0) {
                                document.getElementById('limit').innerText = data.lim;
                                limitBox.classList.remove('hidden');
                            } else {
                                limitBox.classList.add('hidden');
                            }

                            const distElem = document.getElementById('distance');
                            const navHeader = document.getElementById('nav-header');

                            if (data.dst !== undefined && data.dst >= 0 && isNavigating) {
                                let dstText = data.dst >= 1000 ? (data.dst / 1000).toFixed(1) + " km" : data.dst + " m";
                                distElem.innerText = dstText;
                                distElem.classList.remove('hidden');
                                navHeader.classList.remove('hidden');
                            } else {
                                distElem.classList.add('hidden');
                                navHeader.classList.add('hidden');
                            }

                            let st1 = (data.st || "").trim();
                            let st2 = (data.st2 || "").trim();
                            
                            const streetEl = document.getElementById('street');
                            const curStreetEl = document.getElementById('current-street');
                            const freeStreetEl = document.getElementById('street-free');

                            if (st2 !== "" && isNavigating) {
                                streetEl.innerHTML = `<span class="label-text">Tiếp theo:</span>${st2}`;
                                if (st1 !== "" && st1.toLowerCase() !== st2.toLowerCase()) {
                                    curStreetEl.innerHTML = `<span class="label-text">Hiện tại:</span>${st1}`;
                                    curStreetEl.style.display = "block";
                                } else {
                                    curStreetEl.style.display = "none";
                                }
                            } else {
                                if (st1 !== "") {
                                    streetEl.innerHTML = `<span class="label-text">Hiện tại:</span>${st1}`;
                                } else {
                                    streetEl.innerHTML = "Đang định vị...";
                                }
                                curStreetEl.style.display = "none";
                            }

                            if (st1 !== "") {
                                freeStreetEl.innerHTML = `<span class="label-text">Hiện tại:</span>${st1}`;
                            } else {
                                freeStreetEl.innerHTML = "Đang di chuyển tự do";
                            }

                            const alertBanner = document.getElementById('alert-banner');
                            const alertText = document.getElementById('alert-text');
                            const alertIcon = document.getElementById('alert-icon');

                            if (data.alr !== undefined && data.alr > 0 && data.alrD !== undefined && data.alrD <= 850) {
                                let alertName = "Cảnh báo";
                                let svgIcon = IconHazard;
                                
                                switch(data.alr) {
                                    case 1: svgIcon = IconPolice; alertName = "Cảnh sát"; break;
                                    case 2: svgIcon = IconCamera; alertName = "Camera tốc độ"; break;
                                    case 3: svgIcon = IconTrafficLight; alertName = "Camera đèn đỏ"; break;
                                    case 4: svgIcon = IconHazard; alertName = "Nguy hiểm"; break;
                                    case 40: svgIcon = IconCamera; alertName = "Phạt nguội"; break;
                                    default: svgIcon = IconHazard; alertName = "Cảnh báo";
                                }

                                let alertDist = ` • ${data.alrD}m`;
                                alertIcon.innerHTML = svgIcon;
                                alertText.innerText = `${alertName}${alertDist}`;
                                alertBanner.classList.remove('hidden');
                            } else {
                                alertBanner.classList.add('hidden');
                            }

                            if (data.trn !== undefined && isNavigating) {
                                let svgIcon = IconStraight;
                                let text = "Đi thẳng";
                                let isRoundabout = false;
                                
                                switch(data.trn) {
                                    case 1: svgIcon = IconStraight; text = "Đi thẳng"; break;
                                    case 2: case 6: svgIcon = IconLeft; text = "Rẽ trái"; break;
                                    case 3: case 7: svgIcon = IconRight; text = "Rẽ phải"; break;
                                    case 4: svgIcon = IconSlightLeft; text = "Chếch trái"; break;
                                    case 5: svgIcon = IconSlightRight; text = "Chếch phải"; break;
                                    case 8: svgIcon = IconUTurn; text = "Quay đầu"; break;
                                    case 17: svgIcon = IconArrive; text = "Đã đến nơi"; break;
                                    case 10: case 11: case 12: case 19: case 20: 
                                        svgIcon = IconRoundabout; 
                                        text = "Vòng xuyến";
                                        isRoundabout = true;
                                        break;
                                    default: svgIcon = IconStraight; text = "Tiếp tục";
                                }
                                if (data.trn === 0) { svgIcon = IconStraight; text = "Đang đi"; }

                                document.getElementById('turn-icon').innerHTML = svgIcon;
                                document.getElementById('turn-instruction').innerText = text;

                                const exitBadge = document.getElementById('exit-badge');
                                if (isRoundabout && data.exit !== undefined && data.exit > 0) {
                                    exitBadge.innerText = `Lối ra số ${data.exit}`;
                                    exitBadge.classList.remove('hidden');
                                } else {
                                    exitBadge.classList.add('hidden');
                                }
                            }

                            let etaStr = data.eta ? data.eta : "--:--";
                            let rminStr = data.rmin !== undefined ? data.rmin : "--";
                            let distLeftStr = "--";
                            if (data.rm !== undefined && data.rm >= 0) {
                                distLeftStr = (data.rm / 1000).toFixed(1);
                            } else if (data.rkm !== undefined) {
                                distLeftStr = data.rkm;
                            }

                            if (isNavigating) {
                                document.getElementById('eta-text').innerHTML = `ETA ${etaStr} &nbsp;|&nbsp; ${rminStr} phút &nbsp;|&nbsp; ${distLeftStr} km`;
                            } else {
                                document.getElementById('eta-text').innerHTML = `Đang di chuyển tự do`;
                            }
                        }
                    }
                } catch (e) {}
            };
        }

        // Tự động lấy IP thực của máy và Port từ server.py qua HTTP API
        fetch('/api/info')
            .then(res => res.json())
            .then(info => {
                if (info && info.ip) {
                    activeWsPort = info.ws_port || 8765;
                    updateConnectionDisplay(info.ip, activeWsPort);
                }
                connectWebSocket(activeWsPort);
            })
            .catch(() => {
                connectWebSocket(activeWsPort);
            });

        // Bắt các sự kiện touch/click trên toàn trang để đảm bảo các nút luôn phản hồi
        ['touchstart', 'click', 'mousemove'].forEach(evt => {
            document.addEventListener(evt, wakeUpControls, { passive: true });
        });
    </script>
</body>
</html>